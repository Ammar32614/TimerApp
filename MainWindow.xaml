<Window x:Class="TimerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:TimerApp.Controls"
        Title="Stint" Width="380" Height="640" ResizeMode="CanMinimize"
        WindowStyle="None" Background="{StaticResource Bg}"
        FontFamily="{StaticResource TextFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/stint.ico"
        WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="40" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- ================= Full view ================= -->
        <Grid x:Name="FullView">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Brand" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Grid Width="14" Height="14" Margin="0,0,8,0">
                        <c:ProgressRing TrackBrush="{StaticResource Hairline}" ArcBrush="{DynamicResource ModeAccent}"
                                        Thickness="2.5" Progress="0.75"/>
                    </Grid>
                    <TextBlock Text="Stint" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <StackPanel x:Name="BackBar" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back (Esc)"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock x:Name="PageTitleText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LogBtn" Style="{StaticResource IconButton}" Content="&#xE81C;" Click="Log_Click"
                            ToolTip="Study log (Ctrl+L)" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="StatsBtn" Style="{StaticResource IconButton}" Click="Stats_Click"
                            ToolTip="Stats (Ctrl+T)" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,12 h3 v-6 h-3z M5.5,12 h3 v-11 h-3z M11,12 h3 v-8 h-3z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click"
                            ToolTip="Settings" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Border Width="1" Height="16" Background="{StaticResource Hairline}" Margin="6,0"/>
                    <Button x:Name="PinBtn" Style="{StaticResource CaptionButton}" Content="&#xE718;" Click="Pin_Click"
                            ToolTip="Keep on top" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE73F;" Click="Mini_Click"
                            ToolTip="Mini mode" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Timer page stays alive underneath so it keeps running while other pages are open -->
            <ContentControl x:Name="HomeHost" Grid.Row="1" Focusable="False"/>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" Visibility="Collapsed"
                            Background="{StaticResource Bg}"/>
        </Grid>

        <!-- ================= Mini view ================= -->
        <Grid x:Name="MiniView" Visibility="Collapsed" Margin="14,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <c:ProgressRing TrackBrush="{StaticResource Hairline}" Thickness="4" Progress="0"/>
                <c:ProgressRing x:Name="MiniRing" ArcBrush="{DynamicResource ModeAccent}" Thickness="4"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="MiniTime" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Light"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="MiniPhase" Style="{StaticResource Caption}" Margin="1,-2,0,0"/>
            </StackPanel>
            <Button x:Name="MiniPlay" Grid.Column="2" Style="{StaticResource PrimaryRoundButton}" Width="40" Height="40"
                    FontSize="14" Click="MiniPlay_Click" ToolTip="Start or pause (Space)"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="3" Style="{StaticResource CaptionButton}" Content="&#xE740;" Click="Mini_Click"
                    ToolTip="Back to full view" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
    </Grid>
</Window>
