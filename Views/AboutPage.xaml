<UserControl x:Class="TimerApp.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,14,20">
        <StackPanel>
            <!-- Identity -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Image x:Name="AppIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Stint" Style="{StaticResource PageTitle}" FontSize="24"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,14,0,0"
                       Text="A compact study timer that remembers what you studied: focus blocks, a plain timer and a stopwatch, with a study log and stats."/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Made by Ammar32614"/>

            <WrapPanel Margin="-4,12,0,0">
                <Button Style="{StaticResource GhostButton}" Margin="4" Click="GitHub_Click" Content="View on GitHub"/>
                <Button Style="{StaticResource GhostButton}" Margin="4" Click="Issue_Click" Content="Report a problem"/>
                <Button Style="{StaticResource GhostButton}" Margin="4" Click="Releases_Click" Content="What's new"/>
            </WrapPanel>

            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <Grid x:Name="Shortcuts"/>
            </Border>

            <TextBlock Text="Your data" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Text="Stint works offline. Your study log stays on this PC and is never sent anywhere."/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Open data folder" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OpenFolder_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="License" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Text="Free and open source under the MIT License. You can use, change and share it."/>
                    <Button Content="Read the license" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="License_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
