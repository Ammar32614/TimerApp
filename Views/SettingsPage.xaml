<UserControl x:Class="TimerApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,14,20">
        <StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
            <UniformGrid x:Name="Themes" Columns="3" Margin="-4,0,-4,0"/>

            <TextBlock Text="Focus cycle" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="Durations"/>
            </Border>

            <TextBlock Text="Daily goal" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="GoalPanel"/>
            </Border>

            <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AutoBreaks" Style="{StaticResource Switch}" Content="Start breaks automatically"
                              Click="Toggle_Click"/>
                    <CheckBox x:Name="AutoFocus" Style="{StaticResource Switch}" Content="Start focus after a break"
                              Margin="0,12,0,0" Click="Toggle_Click"/>
                    <CheckBox x:Name="Sound" Style="{StaticResource Switch}" Content="Play a sound when time is up"
                              Margin="0,12,0,0" Click="Toggle_Click"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Alarm sound" FontSize="13"/>
                            <TextBlock x:Name="SoundName" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" Click="PreviewSound_Click"
                                    ToolTip="Play the alarm"/>
                            <Button x:Name="DefaultSoundBtn" Style="{StaticResource IconButton}" Content="&#xE777;"
                                    Click="DefaultSound_Click" ToolTip="Use the default alarm"/>
                            <Button Content="Choose…" Style="{StaticResource GhostButton}" Padding="10,4" Margin="4,0,0,0"
                                    Click="ChooseSound_Click" ToolTip="Pick a WAV, MP3 or WMA file"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="OnTop" Style="{StaticResource Switch}" Content="Keep window on top"
                              Margin="0,12,0,0" Click="Toggle_Click"/>
                    <CheckBox x:Name="AtSignIn" Style="{StaticResource Switch}" Content="Start Stint when I sign in"
                              Margin="0,12,0,0" Click="AtSignIn_Click"
                              ToolTip="Opens minimised when you sign in to Windows"/>
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="Subjects" Style="{StaticResource SectionTitle}"/>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Padding="10,4" Margin="0,0,0,6" Click="AddSubject_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Add subject"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel x:Name="Subjects"/>
            </Border>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0"
                       Text="Click a colour dot to change it. Sessions from a deleted subject move to General."/>

            <TextBlock Text="Your data" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <Button Content="Open data folder" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OpenFolder_Click"/>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource GhostButton}" Margin="0,16,0,0" Padding="14,10" Click="About_Click"
                    HorizontalContentAlignment="Stretch" Background="{DynamicResource Surface}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="About Stint" FontSize="13"/>
                        <TextBlock x:Name="Version" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
