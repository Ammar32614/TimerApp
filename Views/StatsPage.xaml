<UserControl x:Class="TimerApp.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,12,16">
        <StackPanel>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Today" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="TodayValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TodaySub" Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Streak" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="StreakValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StreakSub" Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Last 7 days" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="WeekValue" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="0,4,0,0"/>
                        <TextBlock x:Name="WeekSub" Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Daily study" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="GoalLegend" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="BarsHost" Height="130" Margin="0,12,0,0"/>
                    <UniformGrid x:Name="BarLabels" Columns="7" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Subjects, last 7 days" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel x:Name="SubjectRows" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Last 12 weeks" FontWeight="SemiBold" FontSize="13"/>
                    <Grid x:Name="Heat" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="HeatLegend" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
