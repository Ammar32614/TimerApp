<UserControl x:Class="TimerApp.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TimerApp.Views"
             Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="Add_Click" Padding="10,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Add session"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportBtn" Style="{StaticResource IconButton}" Content="&#xE896;" Click="Export_Click"
                        ToolTip="Export to CSV"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,10,16">
            <StackPanel x:Name="List"/>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="40,0,40,60" Visibility="Collapsed">
            <TextBlock Text="Your study log is empty" Style="{StaticResource PageTitle}" FontSize="16"
                       HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                       Text="Finish a focus block and it appears here. Studied without the timer? Add it by hand."/>
        </StackPanel>

        <!-- Undo bar -->
        <Border x:Name="UndoBar" Grid.Row="1" VerticalAlignment="Bottom" Margin="16" Padding="14,8,8,8"
                Background="{DynamicResource Raised}" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <TextBlock Text="Session deleted" VerticalAlignment="Center" FontSize="13"/>
                <Button Content="Undo" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Padding="10,4" Click="Undo_Click"/>
            </Grid>
        </Border>

        <!-- Add / edit overlay -->
        <Grid x:Name="Editor" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}"/>
            <Border Background="{DynamicResource Surface}" CornerRadius="14" Margin="16,8,16,16" Padding="18"
                    VerticalAlignment="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource PageTitle}" FontSize="17"/>

                    <TextBlock Text="Subject" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                    <v:SubjectPicker x:Name="EdSubject" HorizontalAlignment="Left"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Date" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="EdDate" Style="{StaticResource FieldBox}" Tag="2026-11-10" ToolTip="Year-month-day"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Start" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="EdStart" Style="{StaticResource FieldBox}" Tag="09:30" ToolTip="24-hour time"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Minutes" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="EdMinutes" Style="{StaticResource FieldBox}" Tag="25" MaxLength="4"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="What you worked on" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="EdDesc" Style="{StaticResource FieldBox}" Tag="Optional" MaxLength="120"/>

                    <TextBlock Text="Note" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="EdNote" Style="{StaticResource FieldBox}" Tag="Optional" Height="56"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500"/>

                    <TextBlock Text="How focused were you?" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                    <v:RatingPicker x:Name="EdRating"/>

                    <TextBlock x:Name="EdError" Foreground="{DynamicResource Danger}" FontSize="12" Margin="0,12,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="EdCancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="EdSave" Style="{StaticResource AccentButton}" Click="EdSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
