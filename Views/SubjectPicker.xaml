<UserControl x:Class="TimerApp.Views.SubjectPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="Chip" Style="{StaticResource ChipButton}" Click="Chip_Click" Padding="12,0" Height="32"
                ToolTip="Subject for this session">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NameText" Foreground="{DynamicResource Text}" MaxWidth="110"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Margin="7,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Chip}" Placement="Bottom"
               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="4" MinWidth="180"
                    BorderBrush="{DynamicResource Strong}" BorderThickness="1">
                <StackPanel>
                    <ItemsControl x:Name="Items"/>
                    <Border Height="1" Background="{DynamicResource Hairline}" Margin="6,4"/>
                    <Button Style="{StaticResource MenuRowButton}" Click="Manage_Click" Foreground="{DynamicResource Muted}">
                        <TextBlock Text="Manage subjects"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
