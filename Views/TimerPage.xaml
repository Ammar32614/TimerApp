<UserControl x:Class="TimerApp.Views.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TimerApp.Controls"
             xmlns:v="clr-namespace:TimerApp.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- mode switch -->
            <RowDefinition Height="Auto"/>  <!-- subject + description -->
            <RowDefinition Height="*"/>     <!-- ring -->
            <RowDefinition Height="76"/>    <!-- dots / presets / laps -->
            <RowDefinition Height="Auto"/>  <!-- controls -->
            <RowDefinition Height="Auto"/>  <!-- today strip -->
        </Grid.RowDefinitions>

        <!-- Mode switch -->
        <Border Grid.Row="0" Margin="20,6,20,0" Background="{StaticResource Surface}" CornerRadius="10" Padding="3">
            <UniformGrid Columns="3">
                <RadioButton x:Name="FocusTab" Style="{StaticResource Segment}" GroupName="Mode" IsChecked="True"
                             Content="Focus" Checked="Mode_Checked" ToolTip="Focus blocks with breaks (1)"/>
                <RadioButton x:Name="TimerTab" Style="{StaticResource Segment}" GroupName="Mode"
                             Content="Timer" Checked="Mode_Checked" ToolTip="Plain countdown (2)"/>
                <RadioButton x:Name="StopwatchTab" Style="{StaticResource Segment}" GroupName="Mode"
                             Content="Stopwatch" Checked="Mode_Checked" ToolTip="Count up with laps (3)"/>
            </UniformGrid>
        </Border>

        <!-- What am I studying -->
        <Grid Grid.Row="1" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <v:SubjectPicker x:Name="Picker" VerticalAlignment="Center"/>
            <TextBox x:Name="DescBox" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource FieldBox}"
                     Tag="What are you working on?" MaxLength="120" Padding="10,0" Height="32"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Ring -->
        <Grid Grid.Row="2" Width="236" Height="236" VerticalAlignment="Center" Margin="0,8,0,0">
            <c:ProgressRing x:Name="Track" TrackBrush="{StaticResource Hairline}" Thickness="12" Progress="0"/>
            <c:ProgressRing x:Name="Glow" ArcBrush="{DynamicResource ModeAccent}" Thickness="12" Opacity="0.55"
                            IsHitTestVisible="False">
                <c:ProgressRing.Effect>
                    <BlurEffect Radius="22"/>
                </c:ProgressRing.Effect>
            </c:ProgressRing>
            <c:ProgressRing x:Name="Ring" ArcBrush="{DynamicResource ModeAccent}" Thickness="12"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TimeText" Text="25:00" FontFamily="{StaticResource DisplayFont}" FontWeight="Light"
                           FontSize="54" Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>

                <!-- Timer mode: editable h:m:s while idle -->
                <StackPanel x:Name="TimerEdit" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed"
                            Margin="0,4">
                    <TextBox x:Name="TmH" Style="{StaticResource FieldBox}" Width="50" FontSize="24" Padding="2,4"
                             HorizontalContentAlignment="Center" MaxLength="2" ToolTip="Hours"
                             FontFamily="{StaticResource DisplayFont}" PreviewTextInput="Digits_Only"
                             LostFocus="TimerInput_LostFocus" GotKeyboardFocus="Select_All"/>
                    <TextBlock Text=":" FontSize="24" Foreground="{StaticResource Muted}" Margin="3,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TmM" Style="{StaticResource FieldBox}" Width="50" FontSize="24" Padding="2,4"
                             HorizontalContentAlignment="Center" MaxLength="2" ToolTip="Minutes"
                             FontFamily="{StaticResource DisplayFont}" PreviewTextInput="Digits_Only"
                             LostFocus="TimerInput_LostFocus" GotKeyboardFocus="Select_All"/>
                    <TextBlock Text=":" FontSize="24" Foreground="{StaticResource Muted}" Margin="3,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TmS" Style="{StaticResource FieldBox}" Width="50" FontSize="24" Padding="2,4"
                             HorizontalContentAlignment="Center" MaxLength="2" ToolTip="Seconds"
                             FontFamily="{StaticResource DisplayFont}" PreviewTextInput="Digits_Only"
                             LostFocus="TimerInput_LostFocus" GotKeyboardFocus="Select_All"/>
                </StackPanel>

                <TextBlock x:Name="PhaseText" Text="Focus" FontSize="13" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Under the ring: one of three things depending on mode -->
        <Grid Grid.Row="3" Margin="20,6,20,0">
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,6,0,0" ToolTip="Focus blocks in this cycle"/>
            <WrapPanel x:Name="PresetsPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"/>
            <ScrollViewer x:Name="LapsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="LapsList"/>
            </ScrollViewer>
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetBtn" Style="{StaticResource SideRoundButton}" Content="&#xE72C;" Click="Reset_Click"
                    ToolTip="Reset (R)" VerticalAlignment="Center"/>
            <Button x:Name="PlayBtn" Grid.Column="1" Style="{StaticResource PrimaryRoundButton}" Content="&#xF5B0;"
                    Margin="22,0" Click="Play_Click" ToolTip="Start (Space)"/>
            <Button x:Name="SideBtn" Grid.Column="2" Style="{StaticResource SideRoundButton}" Content="&#xE893;"
                    Click="Side_Click" ToolTip="Skip to next (S)" VerticalAlignment="Center"/>
        </Grid>

        <!-- Today strip -->
        <Border Grid.Row="5" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12">
                        <Run Text="Today " Foreground="{StaticResource Muted}"/><Run x:Name="TodayRun" Text="0m" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><Run x:Name="GoalRun" Text=" of 2h" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                    <Grid Height="4" Margin="0,7,0,0" MaxWidth="180" HorizontalAlignment="Left" Width="180">
                        <Border Background="{StaticResource Raised}" CornerRadius="2"/>
                        <Border x:Name="GoalBar" Background="{StaticResource FocusBrush}" CornerRadius="2"
                                HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="StreakText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" ToolTip="Days in a row with study logged"/>
            </Grid>
        </Border>

        <!-- After-session sheet -->
        <Grid x:Name="Sheet" Grid.RowSpan="6" Visibility="Collapsed">
            <Border Background="#B314161C" MouseDown="SheetBackdrop_MouseDown"/>
            <Border x:Name="SheetCard" VerticalAlignment="Bottom" Background="{StaticResource Surface}"
                    CornerRadius="16,16,0,0" Padding="20,18,20,20" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="0,1,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SheetShift"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock x:Name="SheetTitle" Style="{StaticResource PageTitle}" FontSize="18"/>
                    <TextBlock x:Name="SheetSub" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="How focused were you?" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                    <v:RatingPicker x:Name="SheetRating"/>
                    <TextBox x:Name="SheetNote" Style="{StaticResource FieldBox}" Tag="Add a note, e.g. what to pick up next"
                             Margin="0,14,0,0" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" MaxLength="500"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Skip" Style="{StaticResource GhostButton}" Click="SheetSkip_Click" Margin="0,0,8,0"/>
                        <Button Content="Save note" Style="{StaticResource AccentButton}" Click="SheetSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
